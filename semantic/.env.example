# Cube semantic layer: Snowflake connection.
#
# Local dev: copy this file to .env (gitignored) and fill in real values.
# Cube Cloud: set the same variables in the deployment's Environment
# Variables panel (Settings -> Configuration -> Environment Variables).
#
# See ADR-0011 for the connection identity rationale (USER_CUBE +
# ROLE_ANALYST_FINANCE + CONSUMER_WH + ANALYTICS database, default schema
# MARTS in prod, ANALYTICS_DEV.dbt_<initials>_marts in dev).

# Connection target
CUBEJS_DB_TYPE=snowflake
CUBEJS_DB_SNOWFLAKE_ACCOUNT=<ORG>-<ACCOUNT>
CUBEJS_DB_NAME=ANALYTICS
CUBEJS_DB_SCHEMA=MARTS
CUBEJS_DB_SNOWFLAKE_WAREHOUSE=CONSUMER_WH
CUBEJS_DB_SNOWFLAKE_ROLE=ROLE_ANALYST_FINANCE

# Service user
CUBEJS_DB_USER=USER_CUBE

# Key-pair authentication. Path to the PEM-formatted private key
# generated during Phase 1 bootstrap. In Cube Cloud, upload the key
# via the deployment's database connection settings UI instead of
# setting this variable.
CUBEJS_DB_SNOWFLAKE_PRIVATE_KEY_PATH=/path/to/cube_rsa_key.p8

# Optional: enable the Cube dev playground locally.
CUBEJS_DEV_MODE=true
