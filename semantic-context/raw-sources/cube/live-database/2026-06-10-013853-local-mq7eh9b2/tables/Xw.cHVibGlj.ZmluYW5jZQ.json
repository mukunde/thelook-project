{
  "catalog": null,
  "db": "public",
  "name": "finance",
  "kind": "table",
  "comment": "Finance domain BI surface. Exposes the 4 canonical Finance measures\n(net_revenue, gross_margin_rate, financial_return_rate, avg_order_value)\nalong with a curated set of dimensions for cohorting (time, geography,\nproduct taxonomy, order status).\n",
  "estimatedRows": -1,
  "columns": [
    {
      "name": "count",
      "nativeType": "bigint",
      "normalizedType": "bigint",
      "dimensionType": "number",
      "nullable": false,
      "primaryKey": false,
      "comment": "Total number of item lines across orders, including returned items."
    },
    {
      "name": "net_revenue",
      "nativeType": "numeric",
      "normalizedType": "numeric",
      "dimensionType": "number",
      "nullable": false,
      "primaryKey": false,
      "comment": "Total revenue from items sold. Returned items count as zero, so this is\nthe actual money the business kept.\n"
    },
    {
      "name": "gross_margin_rate",
      "nativeType": "numeric",
      "normalizedType": "numeric",
      "dimensionType": "number",
      "nullable": false,
      "primaryKey": false,
      "comment": "Profit margin as a percentage of revenue. A 30% rate means we keep\n30 cents of profit on every euro earned, after paying for the items.\n"
    },
    {
      "name": "financial_return_rate",
      "nativeType": "numeric",
      "normalizedType": "numeric",
      "dimensionType": "number",
      "nullable": false,
      "primaryKey": false,
      "comment": "Share of sales (in euros) that customers returned. A 5% rate means\n5 cents of every euro sold came back as a return.\n"
    },
    {
      "name": "avg_order_value",
      "nativeType": "numeric",
      "normalizedType": "numeric",
      "dimensionType": "number",
      "nullable": false,
      "primaryKey": false,
      "comment": "Average revenue per order. Answers \"how much does a typical customer\nspend in a single order, all items combined?\"\n"
    },
    {
      "name": "gross_revenue",
      "nativeType": "numeric",
      "normalizedType": "numeric",
      "dimensionType": "number",
      "nullable": false,
      "primaryKey": false,
      "comment": "Total sales value before accounting for returns (SUM of sale_price,\nreturned items included at their original price).\n"
    },
    {
      "name": "gross_margin",
      "nativeType": "numeric",
      "normalizedType": "numeric",
      "dimensionType": "number",
      "nullable": false,
      "primaryKey": false,
      "comment": "Total profit after item costs (SUM of per-line gross_margin,\nnet_revenue minus cost).\n"
    },
    {
      "name": "returned_revenue",
      "nativeType": "numeric",
      "normalizedType": "numeric",
      "dimensionType": "number",
      "nullable": false,
      "primaryKey": false,
      "comment": "Sales value lost to returns (SUM of sale_price for returned items\nonly). Numerator of financial_return_rate.\n"
    },
