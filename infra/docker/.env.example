# Copy to .env on the VM and chmod 600. NEVER commit .env.

# ── Public domains ───────────────────────────────────────
# DNS A record (METABASE_DOMAIN -> the OCI VM Reserved Public IP) must exist
# before bringing the stack up, otherwise Let's Encrypt HTTP-01 challenge fails.
METABASE_DOMAIN=metabase.example.dev

# ── Let's Encrypt registration email (used by Caddy) ─────
ACME_EMAIL=you@example.com

# ── Metabase application Postgres ────────────────────────
METABASE_DB_USER=metabase
METABASE_DB_PASSWORD=CHANGE_ME_LONG_RANDOM
METABASE_DB_NAME=metabase
