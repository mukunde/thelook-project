# Caddy v2 configuration: TLS is automatic via Let's Encrypt (HTTP-01 ACME).
#
# Scope: Metabase only for Jalon A.5. Dagster block will be added back in a
# follow-up PR when orchestration/ code lands.
#
# Metabase is proxied without additional auth in front: its own authentication
# covers admin routes, and public dashboards rely on Metabase's own
# anonymous-share mechanism.

{
    email {$ACME_EMAIL}
    # Uncomment for the Let's Encrypt staging endpoint while testing:
    # acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

{$METABASE_DOMAIN} {
    encode gzip zstd

    reverse_proxy metabase:3000

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}
